{
  "name": "bluewallet-web",
  "version": "0.1.0",
  "description": "BlueWallet - Web Edition",
  "license": "MIT",
  "lif": {
    "webapp": "./web/main.tsx",
    "spa": true,
    "web_exports": {
      "./img/*": "./img/*"
    },
    "alt": [
      ".js",
      ".ts",
      ".tsx",
      ".jsx",
      "/index.js",
      "/index.ts",
      "/index.tsx"
    ],
    "transform": {
      "./**/*.js": {
        "type": "jsx"
      }
    },
    "patches": {
      "github:BlueWallet/SilentPayments": {
        "./package.json": {
          "json": {
            "lif": {
              "alt": [".js", ".ts", "/index.js", "/index.ts"]
            }
          }
        }
      },
      "@react-navigation/elements": {
        "./lib/module/index.js": {
          "replace_line": {
            "import backIcon from './assets/back-icon.png';": "const backIcon = import.meta.resolve('./assets/back-icon.png');",
            "import backIconMask from './assets/back-icon-mask.png';": "const backIconMask = import.meta.resolve('./assets/back-icon-mask.png');",
            "import clearIcon from './assets/clear-icon.png';": "const clearIcon = import.meta.resolve('./assets/clear-icon.png');",
            "import closeIcon from './assets/close-icon.png';": "const closeIcon = import.meta.resolve('./assets/close-icon.png');",
            "import searchIcon from './assets/search-icon.png';": "const searchIcon = import.meta.resolve('./assets/search-icon.png');"
          }
        },
        "./lib/module/Header/HeaderBackButton.js": {
          "replace_line": {
            "import backIcon from '../assets/back-icon.png';": "const backIcon = import.meta.resolve('../assets/back-icon.png');",
            "import backIconMask from '../assets/back-icon-mask.png';": "const backIconMask = import.meta.resolve('../assets/back-icon-mask.png');"
          }
        },
        "./lib/module/Header/Header.js": {
          "replace_line": {
            "end: {\nflexDirection: 'row',\nalignItems: 'center',\njustifyContent: 'flex-end'": "end: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    paddingEnd: 16,\n    justifyContent: 'flex-end'",
            "import searchIcon from '../assets/search-icon.png';": "const searchIcon = import.meta.resolve('../assets/search-icon.png');"
          }
        },
        "./lib/module/Header/HeaderSearchBar.js": {
          "replace_line": {
            "import clearIcon from '../assets/clear-icon.png';": "const clearIcon = import.meta.resolve('../assets/clear-icon.png');",
            "import closeIcon from '../assets/close-icon.png';": "const closeIcon = import.meta.resolve('../assets/close-icon.png');",
            "import searchIcon from '../assets/search-icon.png';": "const searchIcon = import.meta.resolve('../assets/search-icon.png');"
          }
        }
      },
      "@react-navigation/drawer": {
        "./lib/module/views/DrawerToggleButton.js": {
          "replace_line": {
            "import toggleDrawerIcon from './assets/toggle-drawer-icon.png';": "const toggleDrawerIcon = import.meta.resolve('./assets/toggle-drawer-icon.png');"
          }
        },
        "./lib/module/views/ScreenFallback.js": {
          "replace_line": {
            "Screens = require('react-native-screens');": "Screens = await import('react-native-screens');"
          }
        }
      },
      "react-native-web": {
        "./dist/index.js": {
          "replace_line": {
            "export { default as useWindowDimensions } from './exports/useWindowDimensions';": "export { default as useWindowDimensions } from './exports/useWindowDimensions';\nexport function codegenNativeComponent(name){ return (props)=>null; }\nexport function PlatformColor(){ return undefined; }\nexport {ToastAndroid} from 'bw-web/toast.js';"
          }
        },
        "./dist/modules/AccessibilityUtil/propsToAccessibilityComponent.js": {
          "replace_line": {
            "button: 'button',": "// button: a <div role=button>, not a <button> element. React Native nests buttons, HTML does not allow a <button> in a <button>"
          }
        },
        "./dist/exports/I18nManager/index.js": {
          "replace_line": {
            "export default I18nManager;": "export {default} from 'bw-web/i18n_manager.js';"
          }
        },
        "./dist/exports/BackHandler/index.js": {
          "replace_line": {
            "export default BackHandler;": "export {default} from 'bw-web/back_handler.js';"
          }
        },
        "./dist/exports/Alert/index.js": {
          "replace_line": {
            "export default Alert;": "export {default} from 'bw-web/alert.js';"
          }
        }
      },
      "@react-navigation/devtools": {
        "./lib/module/index.js": {
          "replace_line": {
            "if (process.env.NODE_ENV !== 'production') {\n  useLogger = require('./useLogger').useLogger;\n  useReduxDevToolsExtension = require('./useReduxDevToolsExtension').useReduxDevToolsExtension;\n} else {\n  useLogger = noop;\n  useReduxDevToolsExtension = noop;\n}": "useLogger = noop;\nuseReduxDevToolsExtension = noop;"
          }
        }
      }
    }
  },
  "scripts": {
    "serve": "node node_modules/lif-kernel/web/serve.js -p 4202"
  },
