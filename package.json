    "patches": {
      "./blue_modules/bc-ur//": {
        "./dist/utils.js": {
          "replace_line": {
            "import { sha256 as _sha256 } from '@noble/hashes/sha256';": "const { sha256: _sha256 } = require('@noble/hashes/sha256');",
            "const {uint8ArrayToHex} = require(\"../../uint8array-extras\");": ""
          }
        }
      },
      "./": {
        "./blue_modules/ur/index.ts": {
          "replace_line": {
            "import { decodeUR as origDecodeUr, encodeUR as origEncodeUR, extractSingleWorkload as origExtractSingleWorkload } from '../bc-ur/dist';": "import { decodeUR as origDecodeUr, encodeUR as origEncodeUR, extractSingleWorkload as origExtractSingleWorkload } from 'bc-ur/dist';"
          }
        },
        "./blue_modules/layout.ts": {
          "replace_line": {
            "import { isDesktop } from './environment';": "import { isDesktop } from './environment';\nimport {wide_layout} from 'bw-web/layout.js';",
            "desktop || Math.min(width, height) >= WIDE_LAYOUT_MIN_LENGTH;": "wide_layout(width);"
          }
        },
        "./screen/settings/ElectrumSettings.tsx": {
          "replace_line": {
            "import loc from '../../loc';": "import loc from '../../loc';\nimport {TlsSecure} from 'bw-web/tls_secure_view.js';",
            "<View style={styles.buttonContainer}>": "<TlsSecure />\n<View style={styles.buttonContainer}>"
          }
        },
        "./navigation/DetailViewScreensStack.tsx": {
          "replace_line": {
            "headerRight: () => (isDesktop ? undefined : RightBarButtons),": "headerRight: () => (isWideLayout ? undefined : RightBarButtons),"
          }
        },
        "./components/SheetHeader.tsx": {
          "replace_line": {
            "if (Platform.OS !== 'android') return null;": ""
          }
        }
